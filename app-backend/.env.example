PORT=4173
CALMA_DATA_DIR=./data
CALMA_PUBLIC_BASE_URL=
CALMA_SIGNUP_ENABLED=true
# Set true only behind the configured HTTPS ingress (local reverse proxy or Vercel).
CALMA_TRUST_PROXY=false
# Stripe platform billing requires a public HTTPS deployment.
CALMA_STRIPE_SECRET_KEY=
CALMA_STRIPE_WEBHOOK_SECRET=
CALMA_STRIPE_PRICE_ID=
# Meta app credentials secure webhook verification; never put these in workspace form.
CALMA_META_APP_SECRET=
CALMA_META_WEBHOOK_VERIFY_TOKEN=
# Generated automatically on first start; keep this with your database backups.
CALMA_ENCRYPTION_KEY=

# Provider secrets belong in each workspace's Integrations page.
META_GRAPH_VERSION=v23.0
GOOGLE_SYNC_INTERVAL_SECONDS=300
GOOGLE_BASELINE_PAGES_PER_SYNC=20
GOOGLE_SYNC_MAX_PAGES_PER_LOCATION=5
CALMA_DAILY_INSIGHT_ENABLED=true
CALMA_DAILY_INSIGHT_TIME=08:00
CALMA_TIMEZONE=Asia/Kolkata

# For Vercel, use Supabase's pooler URL with sslmode=require. Calma disables
# psycopg prepared statements and sets each workspace schema inside its transaction.
# Production authentication requires PostgreSQL, HTTPS, SMTP, Google OAuth, and stable secrets.
CALMA_ENV=development
DATABASE_URL=
CALMA_JWT_SECRET=
CALMA_GOOGLE_OAUTH_CLIENT_ID=
CALMA_GOOGLE_OAUTH_CLIENT_SECRET=
CALMA_AUTH_SMTP_HOST=
CALMA_AUTH_SMTP_PORT=587
CALMA_AUTH_SMTP_STARTTLS=true
CALMA_AUTH_SMTP_USER=
CALMA_AUTH_SMTP_PASSWORD=
CALMA_AUTH_FROM_EMAIL=
